<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pedidos Directo</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container container-wide">
    <p class="brand">Pedidos Directo</p>
    <h1>Haz tu pedido</h1>
    <p class="subtitle">Selecciona los productos que quieres y la cantidad de cada uno.</p>

    <% if (success) { %>
      <div class="alert alert-success">
        ¡Gracias! Tu pedido fue recibido correctamente.
      </div>
    <% } %>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach(function(e) { %>
            <li><%= e.msg %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/pedido" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (!products.length) { %>
        <p class="empty-catalog">Todavía no hay productos disponibles. Vuelve pronto.</p>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(function(p) { %>
            <div class="product-card">
              <img src="/images/<%= p.image %>" alt="<%= p.name %>" class="product-image" id="img_<%= p.id %>" />
              <p class="product-name"><%= p.name %></p>
              <% if (p.description) { %><p class="product-description"><%= p.description %></p><% } %>
              <% if (p.price) { %><p class="product-price">$<%= p.price %></p><% } %>
              <% if (p.colors && p.colors.length) { %>
                <p class="colors-title">Colores</p>
                <div class="color-list">
                  <% p.colors.forEach(function(c) { var field = 'qty_' + p.id + '__' + c.id; %>
                    <div class="color-row">
                      <button type="button" class="color-swatch" data-color="<%= c.hex %>"
                        data-target="img_<%= p.id %>" data-image="/images/<%= c.image %>"
                        aria-label="Ver color <%= c.name %>" title="<%= c.name %>"></button>
                      <label for="<%= field %>" class="color-name"><%= c.name %><% if (c.note) { %><span class="color-note"><%= c.note %></span><% } %></label>
                      <input type="number" id="<%= field %>" name="<%= field %>" min="0" max="50"
                        value="<%= values[field] || 0 %>"
                        data-target="img_<%= p.id %>" data-image="/images/<%= c.image %>" />
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <label for="qty_<%= p.id %>">Cantidad</label>
                <input
                  type="number"
                  id="qty_<%= p.id %>"
                  name="qty_<%= p.id %>"
                  min="0"
                  max="50"
                  value="<%= values['qty_' + p.id] || 0 %>"
                />
              <% } %>
            </div>
          <% }); %>
        </div>

        <h2 class="section-title">Tus datos</h2>

        <label for="name">Nombre completo *</label>
        <input type="text" id="name" name="name" maxlength="100" required value="<%= values.name || '' %>" />

        <label for="phone">Telefono de contacto *</label>
        <input type="tel" id="phone" name="phone" maxlength="30" required value="<%= values.phone || '' %>" />

        <label for="email">Correo electronico *</label>
        <input type="email" id="email" name="email" maxlength="100" required value="<%= values.email || '' %>" />
        <p class="field-hint">Te avisaremos a este correo cuando tu pedido sea enviado.</p>

        <h2 class="section-title">Direccion de entrega</h2>

        <label for="street">Calle y numero *</label>
        <input type="text" id="street" name="street" maxlength="150" required autocomplete="street-address" placeholder="Ej. Av. Juarez 123, int. 4" value="<%= values.street || '' %>" />

        <label for="colonia">Colonia *</label>
        <input type="text" id="colonia" name="colonia" maxlength="100" required value="<%= values.colonia || '' %>" />

        <div class="field-row">
          <div>
            <label for="city">Ciudad o municipio *</label>
            <input type="text" id="city" name="city" maxlength="100" required autocomplete="address-level2" value="<%= values.city || '' %>" />
          </div>
          <div>
            <label for="zip">Codigo postal *</label>
            <input type="text" id="zip" name="zip" maxlength="5" inputmode="numeric" pattern="[0-9]{5}" required autocomplete="postal-code" value="<%= values.zip || '' %>" />
          </div>
        </div>

        <label for="state">Estado *</label>
        <select id="state" name="state" required>
          <option value="">Selecciona tu estado</option>
          <% estados.forEach(function(e) { %>
            <option value="<%= e %>" <%= values.state === e ? 'selected' : '' %>><%= e %></option>
          <% }); %>
        </select>

        <label for="references">Referencias (opcional)</label>
        <textarea id="references" name="references" maxlength="300" rows="2" placeholder="Ej. Casa azul, entre calle X y calle Y"><%= values.references || '' %></textarea>

        <button type="submit">Enviar pedido</button>
      <% } %>
    </form>

    <p class="footer-link"><a href="/admin/login">Acceso administrador</a></p>
  </main>
  <script src="/js/catalogo.js"></script>
</body>
</html>
