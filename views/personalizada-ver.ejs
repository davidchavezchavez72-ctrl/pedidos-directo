<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pedidos Directo — Tu esfera personalizada</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container">
    <p class="brand">Pedidos Directo</p>
    <h1>Tu esfera personalizada</h1>
    <% if (request.brand) { %><p class="subtitle">Con el logo de <strong><%= request.brand %></strong></p><% } %>

    <img src="/personalizada/ver/<%= request.token %>/imagen" alt="Diseño de tu esfera personalizada" class="mockup-image" />

    <% if (done) { %>
      <div class="alert alert-success">
        ¡Gracias! Tu pedido fue recibido correctamente.
        <div class="success-total">
          <% (done.pricing || []).forEach(function(l) { %>
            <p><%= l.qty %>x <%= l.name %>: $<%= l.subtotal.toLocaleString('es-MX') %></p>
          <% }); %>
          <p class="success-total-sum">Total de tu compra: <strong>$<%= done.total.toLocaleString('es-MX') %></strong></p>
        </div>
      </div>
    <% } else if (request.status === 'pedido') { %>
      <div class="alert alert-success">Ya hiciste el pedido de esta esfera. ¡Gracias!</div>
    <% } else if (expired) { %>
      <div class="alert alert-error">
        El plazo para pedir esta esfera terminó (<%= expiresText %>). Contáctanos y con gusto te ayudamos.
      </div>
    <% } else { %>
      <p class="custom-deadline">Tienes hasta el <strong><%= expiresText %></strong> para hacer tu pedido.</p>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <ul>
            <% errors.forEach(function(e) { %>
              <li><%= e.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/personalizada/ver/<%= request.token %>/pedido" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="product-card custom-qty" data-product="<%= custom.id %>" data-price="<%= custom.price %>" data-dozen="<%= custom.dozenPrice %>">
          <p class="product-name"><%= custom.name %></p>
          <p class="product-price">$<%= custom.price %> c/u</p>
          <p class="product-dozen">Docena (12): <strong>$<%= custom.dozenPrice.toLocaleString('es-MX') %></strong></p>
          <label for="quantity">¿Cuántas esferas quieres? *</label>
          <input type="number" id="quantity" name="quantity" min="1" max="500" required value="<%= values.quantity || '' %>" />
        </div>

        <div class="order-total" id="order-total" hidden>
          <div id="order-total-lines"></div>
          <p class="order-total-sum">Total: <strong id="order-total-sum">$0</strong></p>
        </div>

        <h2 class="section-title">Tus datos</h2>

        <label for="name">Nombre completo *</label>
        <input type="text" id="name" name="name" maxlength="100" required value="<%= values.name || '' %>" />

        <label for="phone">Teléfono de contacto *</label>
        <input type="tel" id="phone" name="phone" maxlength="30" required value="<%= values.phone || '' %>" />

        <label for="email">Correo electrónico *</label>
        <input type="email" id="email" name="email" maxlength="100" required value="<%= values.email || '' %>" />

        <h2 class="section-title">Dirección de entrega</h2>

        <label for="street">Calle y número *</label>
        <input type="text" id="street" name="street" maxlength="150" required autocomplete="street-address" value="<%= values.street || '' %>" />

        <label for="colonia">Colonia *</label>
        <input type="text" id="colonia" name="colonia" maxlength="100" required value="<%= values.colonia || '' %>" />

        <div class="field-row">
          <div>
            <label for="city">Ciudad o municipio *</label>
            <input type="text" id="city" name="city" maxlength="100" required autocomplete="address-level2" value="<%= values.city || '' %>" />
          </div>
          <div>
            <label for="zip">Código postal *</label>
            <input type="text" id="zip" name="zip" maxlength="5" inputmode="numeric" pattern="[0-9]{5}" required autocomplete="postal-code" value="<%= values.zip || '' %>" />
          </div>
        </div>

        <label for="state">Estado *</label>
        <select id="state" name="state" required>
          <option value="">Selecciona tu estado</option>
          <% estados.forEach(function(e) { %>
            <option value="<%= e %>" <%= values.state === e ? 'selected' : '' %>><%= e %></option>
          <% }); %>
        </select>

        <label for="references">Referencias (opcional)</label>
        <textarea id="references" name="references" maxlength="300" rows="2"><%= values.references || '' %></textarea>

        <p class="submit-total" id="submit-total" hidden>Total de tu compra: <strong id="submit-total-sum">$0</strong></p>
        <button type="submit">Hacer pedido</button>
      </form>

      <div class="total-bar" id="total-bar" hidden>
        <span><span id="total-bar-count">0</span> esferas</span>
        <span>Total: <strong id="total-bar-sum">$0</strong></span>
      </div>
    <% } %>

    <p class="footer-link"><a href="/">Ir a la tienda</a></p>
  </main>
  <script src="/js/catalogo.js"></script>
</body>
</html>
