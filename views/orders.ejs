<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pedidos Directo — Panel de pedidos</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container container-wide">
    <div class="orders-header">
      <h1>Pedidos recibidos (<%= orders.length %>)</h1>
      <form action="/admin/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn-secondary">Cerrar sesion</button>
      </form>
    </div>

    <% if (!orders.length) { %>
      <p>Todavia no hay pedidos.</p>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach(function(o) { %>
          <article class="order-card">
            <header>
              <strong>#<%= o.id %> — <%= o.name %></strong>
              <span class="order-date"><%= new Date(o.created_at).toLocaleString('es-ES') %></span>
            </header>
            <p><strong>Telefono:</strong> <%= o.phone %></p>
            <p><strong>Correo:</strong> <%= o.email %></p>
            <% if (o.address) { %>
              <p><strong>Direccion:</strong>
                <%= o.address.street %>, Col. <%= o.address.colonia %>,
                <%= o.address.city %>, <%= o.address.state %>, C.P. <%= o.address.zip %>
                <% if (o.address.references) { %><br /><span class="order-date">Referencias: <%= o.address.references %></span><% } %>
              </p>
            <% } %>
            <p><strong>Estado:</strong>
              <span class="status-badge status-<%= o.status %>">
                <%= o.status === 'enviado' ? 'Enviado' : 'Pendiente' %>
              </span>
            </p>

            <p><strong>Productos:</strong></p>
            <div class="order-items">
              <% (o.items || []).forEach(function(item) { %>
                <div class="order-item">
                  <img src="/images/<%= item.image %>" alt="<%= item.name %>" class="order-item-image" />
                  <span>
                    <strong><%= item.quantity %>x</strong> <%= item.name %>
                    <% if (item.color) { %>
                      <br /><span class="color-dot" data-color="<%= item.colorHex || '#cccccc' %>"></span> Color: <strong><%= item.color %></strong><% if (item.colorNote) { %> <span class="color-note-inline">(<%= item.colorNote %>)</span><% } %>
                    <% } %>
                  </span>
                </div>
              <% }); %>
            </div>

            <% if (o.total) { %>
              <div class="order-pricing">
                <% (o.pricing || []).forEach(function(l) { %>
                  <p><%= l.qty %>x <%= l.name %>:
                    <% if (l.dozens) { %><%= l.dozens %> docena<%= l.dozens > 1 ? 's' : '' %> ($<%= l.dozenPrice %>)<% } %><% if (l.dozens && l.rest) { %> + <% } %><% if (l.rest) { %><%= l.rest %> pieza<%= l.rest > 1 ? "s" : "" %> ($<%= l.price %> c/u)<% } %>
                    = <strong>$<%= l.subtotal %></strong></p>
                <% }); %>
                <p class="order-total-sum">Total: <strong>$<%= o.total %></strong></p>
              </div>
            <% } %>

            <% if (o.status !== 'enviado') { %>
              <form action="/admin/pedidos/<%= o.id %>/enviar" method="POST" class="ship-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit">Marcar como enviado</button>
              </form>
            <% } %>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>
  <script src="/js/catalogo.js"></script>
</body>
</html>
