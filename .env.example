# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA compartas tu archivo .env ni lo subas a internet/git.

# Puerto donde corre el servidor
PORT=3000

# Entorno: development o production
NODE_ENV=development

# Clave secreta para firmar las sesiones. Genera una con:
#   npm run gen-secret
SESSION_SECRET=

# Usuario del panel de administrador
ADMIN_USERNAME=admin

# Hash de la contraseña del administrador (NO la contraseña en texto plano).
# Genera el hash con:
#   npm run hash-password
ADMIN_PASSWORD_HASH=

# --- Base de datos (PostgreSQL) ---
# Si se deja vacia, se usa un almacen en memoria (solo para desarrollo, se
# pierde al reiniciar). En produccion SIEMPRE define esta variable con una
# base de datos PostgreSQL real (por ejemplo, "New Postgres" en Render).
DATABASE_URL=

# --- Correo (Resend) ---
# Crea una cuenta gratis en https://resend.com con tu correo y genera una API Key en:
# https://resend.com/api-keys
RESEND_API_KEY=

# Correo que RECIBE la notificacion de cada pedido (debe ser el mismo con el que
# te registraste en Resend, a menos que verifiques un dominio propio)
EMAIL_TO=davidchavezchavez74@gmail.com
