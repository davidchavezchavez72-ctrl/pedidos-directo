# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA compartas tu archivo .env ni lo subas a internet/git.

# Puerto donde corre el servidor
PORT=3000

# Entorno: development o production
NODE_ENV=development

# Clave secreta para firmar las sesiones. Genera una con:
#   npm run gen-secret
SESSION_SECRET=

# Usuario del panel de administrador
ADMIN_USERNAME=admin

# Hash de la contraseña del administrador (NO la contraseña en texto plano).
# Genera el hash con:
#   npm run hash-password
ADMIN_PASSWORD_HASH=

# --- Correo (Gmail) ---
# Cuenta de Gmail que ENVIA la notificacion. Debe ser una "Contraseña de aplicacion"
# de Google (no tu contraseña normal). Se genera en:
# https://myaccount.google.com/apppasswords  (requiere verificacion en 2 pasos activada)
EMAIL_USER=davidchavezchavez74@gmail.com
EMAIL_PASS=

# Correo que RECIBE la notificacion de cada pedido
EMAIL_TO=davidchavezchavez74@gmail.com
